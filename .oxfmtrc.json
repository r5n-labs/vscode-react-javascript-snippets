{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "ignorePatterns": [
    "lib/**",
    "node_modules/**",
    "src/snippets/generated.code-snippets",
    "*.vsix",
    "bun.lock",
    "yarn.lock"
  ]
}
